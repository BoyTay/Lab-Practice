<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toast_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_custom_toast"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/toast_horizontal_padding"
    android:paddingTop="@dimen/toast_vertical_padding"
    android:paddingEnd="@dimen/toast_horizontal_padding"
    android:paddingBottom="@dimen/toast_vertical_padding">

    <ImageView
        android:id="@+id/toast_icon"
        android:layout_width="@dimen/toast_icon_size"
        android:layout_height="@dimen/toast_icon_size"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/toast_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/toast_icon_spacing"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>

